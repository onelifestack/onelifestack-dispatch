{
  "name": "onelifestack-dispatch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "build:cli": "esbuild src/cli/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-cli/dispatch-run.mjs --banner:js='#!/usr/bin/env node' --log-level=warning"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "chai": "^5.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chai": "^5.2.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^25.0.1",
    "typescript": "5.6",
    "vite": "^6.4.5",
    "vitest": "^2.1.9"
  },
  "bin": {
    "dispatch-run": "dist-cli/dispatch-run.mjs"
  }
}
